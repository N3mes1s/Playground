# Copy to .env and fill in. .env is gitignored.

# Required: any OpenAI-compatible key
OPENAI_API_KEY=

# Default model for all experiments. Override per-run via --model on each CLI.
MODEL=gpt-5.4-mini

# Optional: alternate base URL for OpenAI-compatible endpoints (Azure, OpenRouter, local).
# Leave blank for OpenAI default.
OPENAI_BASE_URL=

# Optional: directory for local agent memory. Defaults to ./.mirofish_memory/.
MIROFISH_MEMORY_DIR=

# Optional: max tokens per agent response. Sane default in code.
MAX_TOKENS=4096
