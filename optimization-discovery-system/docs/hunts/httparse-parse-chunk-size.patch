+fn chunk_size(c: &mut Criterion) {
+    fn _chunk(c: &mut Criterion, name: &str, input: &'static [u8]) {
+        c.benchmark_group("chunk_size")
+        .throughput(Throughput::Bytes(input.len() as u64))
+        .bench_function(name, |b| b.iter(|| {
+            httparse::parse_chunk_size(black_box(input)).unwrap()
+        }));
+    }
+
+    _chunk(c, "small", b"0\r\n");
+    _chunk(c, "medium", b"3086d\r\n");
+    _chunk(c, "large", b"ffffffffffffffff\r\n");
+    _chunk(c, "ext", b"3735AB1;foo bar*\r\n");
+    _chunk(c, "ext_ws", b"3735ab1 ; baz \r\n");
+}
+
